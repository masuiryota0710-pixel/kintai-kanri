# =========================================================
# Supabase 接続設定（このファイルをコピーして .env を作成）
#   値を入れたら:  sh scripts/setup.sh
# =========================================================

# --- 必須：プロジェクトID（Project Settings → General → Project ID / Reference ID）
#     例: abcdefghijklmnopqrst  （URL https://abcdefghijklmnopqrst.supabase.co の先頭部分）
SUPABASE_PROJECT_REF=

# --- 推奨：アクセストークン（https://supabase.com/dashboard/account/tokens で発行）
#     入れておくと setup.sh が以下を自動で行います
#       ・supabase/schema.sql の実行（テーブル・権限の作成）
#       ・「Confirm email」をオフ
#       ・anon キーの取得（下の SUPABASE_ANON_KEY が空でもOK）
#     ※ アカウント全体を操作できる秘密の値です。他人に渡したり、公開したりしないでください。
#       ブラウザ用の js/config.js には書き出されません。
SUPABASE_ACCESS_TOKEN=

# --- 任意：URL と anon キー（空なら PROJECT_REF / ACCESS_TOKEN から自動設定）
#     Project Settings → API にある値。service_role / secret キーは入れないこと。
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- 最初の管理者のメールアドレス（setup.sh が管理者用の招待コードを発行します）
SUPABASE_ADMIN_EMAIL=
